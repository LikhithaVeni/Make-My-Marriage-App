# Copy to .env.local and fill in what you need. Every service is optional in
# development: anything left empty is reported as "not configured".
# Never commit real values.

# --- Server-only (never sent to the browser) ---

# MongoDB Atlas connection string, including the database name
# (mmm_preview for Preview, mmm_prod for Production). A local MongoDB must run
# as a replica set, because the app uses transactions.
MONGODB_URI=

# Optional: a separate, empty database for the tests that need MongoDB
# (pnpm test skips them when this is empty). Each run DROPS this database, so
# never point it at one with real data, e.g. .../mmm_test on the dev cluster.
MONGODB_TEST_URI=

# Cloudflare R2 object storage for photos, receipts and vendor documents.
# All four are needed together. Bucket: mmm-preview or mmm-prod.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Resend API key for transactional email (invitations, reminders, verification).
RESEND_API_KEY=

# Shared secret the external scheduler sends in the X-Job-Secret header when it
# calls POST /api/jobs/run. At least 32 characters.
JOB_SECRET=

# Key used to sign the professional-album access cookie (mmm_pro). Organiser
# sessions are random ids stored hashed in MongoDB, so they are not signed.
# At least 32 characters.
SESSION_SECRET=

# --- Public (inlined into the browser bundle at build time) ---

# Base URL of the app, used for invitation and upload links.
# Defaults to http://localhost:3000 outside production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
